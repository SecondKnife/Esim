# Frontend .gitignore

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env*.local
.env
.env.production

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Helper scripts (local development only)
*.bat
*.ps1
KILL_PORT.*

# Temporary files
*.tmp
*.temp

# IDE
.vscode/
.idea/

# Keep important documentation
!README.md
!LICENSE.md

# Remove overly broad patterns (keep specific docs)
# Commented out these broad patterns:
# .md
# .txt
